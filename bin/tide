#!/usr/bin/env bash
# TIDE workspace launcher for Linux, macOS, BSD, and Windows through WSL.
set -euo pipefail

readonly TIDE_VERSION="0.5.2"

usage() {
  cat <<'EOF'
TIDE — Terminal IDE

Usage:
  tide [tide-options] [agent [agent-args...]]
  tide [tide-options] agent1 [args...] :: agent2 [args...]
  tide --editor [path]

Examples:
  tide pi
  tide pi -c
  tide pi --model gpt-5
  tide pi -c :: claude --continue
  tide --project ~/code/my-app codex
  tide                         # editor, terminal, and an empty agent pane

TIDE options (must appear before the agent command):
  -p, --project PATH           Project directory (default: current directory)
  -s, --session-name NAME      tmux session name
  -r, --resume NAME            Attach to NAME, or create it when absent
      --list-sessions          List restorable TIDE sessions
      --layout VALUE           classic, agents-left, or agents-bottom
      --shell-size PERCENT     Project-shell height (10-50; default: 15)
      --agent-size PERCENT     Agent area size (15-60; default: 30)
      --editor [PATH]          Open only the TIDE editor
      --no-attach              Create the workspace without attaching
      --image-protocol VALUE   auto, sixel, kitty, iterm2, or halfblocks
  -h, --help                   Show this help
  -V, --version                Show the version

Use :: to separate two or more agent commands. Everything after the first
non-TIDE option is passed to the agent unchanged.
EOF
}

fail() {
  printf 'tide: %s\n' "$*" >&2
  exit 1
}

command_string() {
  local rendered
  printf -v rendered '%q ' "$@"
  printf '%s' "${rendered% }"
}

reflow_workspace() {
  local workspace=$1 layout=$2 shell_size=$3 agent_size=$4 editor_pane=$5 terminal_pane=$6
  local panes_value=$7 editor_visible=$8 agent_visible=$9 terminal_visible=${10}
  local anchor pane pane_window primary_agent
  local -a panes
  IFS=, read -r -a panes <<<"$panes_value"
  primary_agent=${panes[0]}

  if [[ $editor_visible == 1 ]]; then
    anchor=$editor_pane
  elif [[ $agent_visible == 1 ]]; then
    anchor=$primary_agent
  else
    anchor=$terminal_pane
  fi

  for pane in "$editor_pane" "$terminal_pane" "${panes[@]}"; do
    [[ $pane == "$anchor" ]] && continue
    pane_window=$(tmux display-message -p -t "$pane" '#{window_id}')
    if [[ $pane_window == "$workspace" ]]; then
      tmux break-pane -d -s "$pane" -n '_tide-reflow'
    fi
  done

  if [[ $terminal_visible == 1 && $terminal_pane != "$anchor" ]]; then
    tmux join-pane -d -v -l "${shell_size}%" -s "$terminal_pane" -t "$anchor"
  fi
  if [[ $agent_visible == 1 && $primary_agent != "$anchor" ]]; then
    case "$layout" in
      classic) tmux join-pane -d -h -l "${agent_size}%" -s "$primary_agent" -t "$editor_pane" ;;
      agents-left) tmux join-pane -d -h -b -l "${agent_size}%" -s "$primary_agent" -t "$editor_pane" ;;
      agents-bottom) tmux join-pane -d -v -l "${agent_size}%" -s "$primary_agent" -t "$editor_pane" ;;
    esac
  fi
  if [[ $agent_visible == 1 ]]; then
    for pane in "${panes[@]:1}"; do
      tmux join-pane -d -v -s "$pane" -t "$primary_agent"
    done
  fi
}

toggle_workspace_pane() {
  local role=${1:-} source=${2:-${TMUX_PANE:-}} option panes_value visible
  local workspace layout shell_size agent_size editor_pane terminal_pane anchor pane focus_pane
  local editor_visible agent_visible terminal_visible
  local -a panes
  command -v tmux >/dev/null 2>&1 || fail "tmux is required"
  [[ -n $source ]] || fail "pane toggle must run inside tmux"

  workspace=$(tmux display-message -p -t "$source" '#{window_id}')
  layout=$(tmux display-message -p -t "$source" '#{@tide_layout}')
  [[ -n $layout ]] || fail "this is not a TIDE workspace window"
  shell_size=$(tmux display-message -p -t "$source" '#{@tide_shell_size}')
  agent_size=$(tmux display-message -p -t "$source" '#{@tide_agent_size}')
  editor_pane=$(tmux display-message -p -t "$source" '#{@tide_editor_pane}')
  terminal_pane=$(tmux display-message -p -t "$source" '#{@tide_terminal_pane}')
  panes_value=$(tmux display-message -p -t "$source" '#{@tide_agent_panes}')
  IFS=, read -r -a panes <<<"$panes_value"
  editor_visible=$(tmux display-message -p -t "$source" '#{@tide_editor_visible}')
  agent_visible=$(tmux display-message -p -t "$source" '#{@tide_agent_visible}')
  terminal_visible=$(tmux display-message -p -t "$source" '#{@tide_terminal_visible}')

  case "$role" in
    editor) option=@tide_editor_visible; visible=$editor_visible ;;
    agent) option=@tide_agent_visible; visible=$agent_visible ;;
    terminal) option=@tide_terminal_visible; visible=$terminal_visible ;;
    *) fail "unknown pane role: $role" ;;
  esac

  if [[ $visible == 1 ]]; then
    if (( editor_visible + agent_visible + terminal_visible <= 1 )); then
      tmux display-message -t "$source" "TIDE keeps at least one workspace pane visible"
      return 0
    fi
    case "$role" in
      editor)
        tmux break-pane -d -s "$editor_pane" -n '_tide-hidden-editor'
        editor_visible=0
        ;;
      agent)
        for pane in "${panes[@]}"; do
          tmux break-pane -d -s "$pane" -n '_tide-hidden-agent'
        done
        agent_visible=0
        ;;
      terminal)
        tmux break-pane -d -s "$terminal_pane" -n '_tide-hidden-terminal'
        terminal_visible=0
        ;;
    esac
    tmux set-option -w -t "$workspace" "$option" 0
  else
    if [[ $editor_visible == 1 ]]; then
      anchor=$editor_pane
    elif [[ $agent_visible == 1 ]]; then
      anchor=${panes[0]}
    else
      anchor=$terminal_pane
    fi
    case "$role" in
      editor)
        tmux join-pane -d -s "$editor_pane" -t "$anchor"
        editor_visible=1
        focus_pane=$editor_pane
        ;;
      agent)
        for pane in "${panes[@]}"; do
          tmux join-pane -d -s "$pane" -t "$anchor"
        done
        agent_visible=1
        focus_pane=${panes[0]}
        ;;
      terminal)
        tmux join-pane -d -s "$terminal_pane" -t "$anchor"
        terminal_visible=1
        focus_pane=$terminal_pane
        ;;
    esac
    tmux set-option -w -t "$workspace" "$option" 1
  fi

  reflow_workspace "$workspace" "$layout" "$shell_size" "$agent_size" \
    "$editor_pane" "$terminal_pane" "$panes_value" \
    "$editor_visible" "$agent_visible" "$terminal_visible"
  tmux select-window -t "$workspace"
  if [[ $visible == 0 ]]; then
    tmux select-pane -t "$focus_pane"
  fi
}

if [[ ${1:-} == --_toggle-pane ]]; then
  toggle_workspace_pane "${2:-}" "${3:-}"
  exit 0
fi

# Read a scalar from a small TOML section without evaluating project content.
toml_scalar() {
  local file=$1 section=$2 key=$3
  awk -v wanted_section="$section" -v wanted_key="$key" '
    function trim(value) { sub(/^[[:space:]]+/, "", value); sub(/[[:space:]]+$/, "", value); return value }
    /^[[:space:]]*\[/ {
      current=$0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", current); next
    }
    current == wanted_section && $0 ~ "^[[:space:]]*" wanted_key "[[:space:]]*=" {
      value=$0; sub(/^[^=]*=/, "", value); sub(/[[:space:]]+#.*$/, "", value); value=trim(value)
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) value=substr(value, 2, length(value)-2)
      print value; exit
    }
  ' "$file"
}

project="$PWD"
session_name=""
attach=1
restore=0
list_sessions=0
layout=""
shell_size=""
agent_size=""
protocol="${TIDE_IMAGE_PROTOCOL:-auto}"

while (( $# )); do
  case "$1" in
    -p|--project)
      (( $# >= 2 )) || fail "$1 requires a path"
      project=$2
      shift 2
      ;;
    -s|--session-name)
      (( $# >= 2 )) || fail "$1 requires a name"
      session_name=$2
      shift 2
      ;;
    -r|--resume)
      (( $# >= 2 )) || fail "$1 requires a name"
      session_name=$2
      restore=1
      shift 2
      ;;
    --list-sessions)
      list_sessions=1
      shift
      ;;
    --layout)
      (( $# >= 2 )) || fail "$1 requires a value"
      layout=$2
      shift 2
      ;;
    --shell-size)
      (( $# >= 2 )) || fail "$1 requires a percentage"
      shell_size=$2
      shift 2
      ;;
    --agent-size)
      (( $# >= 2 )) || fail "$1 requires a percentage"
      agent_size=$2
      shift 2
      ;;
    --image-protocol)
      (( $# >= 2 )) || fail "$1 requires a value"
      protocol=$2
      shift 2
      ;;
    --editor)
      shift
      command -v tide-editor >/dev/null 2>&1 || fail "tide-editor is not installed"
      exec tide-editor "${1:-$project}"
      ;;
    --no-attach)
      attach=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -V|--version)
      printf 'tide %s\n' "$TIDE_VERSION"
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

command -v tmux >/dev/null 2>&1 || fail "tmux is required (on Windows, run TIDE inside WSL)"
# Distinguish Ctrl+Shift home-row chords from their traditional Ctrl-only bytes.
tmux set-option -s extended-keys on
if (( list_sessions )); then
  tmux list-sessions -F '#{session_name}\t#{@tide_project}\t#{session_attached}' 2>/dev/null \
    | awk -F '\t' '$1 ~ /^tide-/ || $2 != "" { printf "%-32s  %s%s\n", $1, ($2 == "" ? "unknown project" : $2), ($3 > 0 ? "  [attached]" : "") }'
  exit 0
fi
command -v tide-editor >/dev/null 2>&1 || fail "tide-editor is not installed"
[[ -d $project ]] || fail "project directory does not exist: $project"
project=$(cd "$project" && pwd -P)

config_file="$project/.tide.toml"
if [[ -f $config_file ]]; then
  [[ -n $layout ]] || layout=$(toml_scalar "$config_file" workspace layout)
  [[ -n $shell_size ]] || shell_size=$(toml_scalar "$config_file" workspace shell_size)
  [[ -n $agent_size ]] || agent_size=$(toml_scalar "$config_file" workspace agent_size)
  if [[ -z $session_name ]]; then
    session_name=$(toml_scalar "$config_file" workspace session)
    [[ $session_name != project ]] || session_name="tide-$(basename "$project" | tr -cs '[:alnum:]_-' '-')"
  fi
  config_restore=$(toml_scalar "$config_file" workspace restore)
  [[ $config_restore != true ]] || restore=1
fi
if [[ -n $session_name && ! $session_name =~ ^[[:alnum:]_.-]+$ ]]; then
  fail "session name may contain only letters, numbers, dot, underscore, and hyphen"
fi
layout=${layout:-classic}
shell_size=${shell_size:-15}
agent_size=${agent_size:-30}
case "$layout" in classic|agents-left|agents-bottom) ;; *) fail "unsupported layout: $layout" ;; esac
[[ $shell_size =~ ^[0-9]+$ ]] && (( shell_size >= 10 && shell_size <= 50 )) || fail "shell size must be between 10 and 50"
[[ $agent_size =~ ^[0-9]+$ ]] && (( agent_size >= 15 && agent_size <= 60 )) || fail "agent size must be between 15 and 60"

case "$protocol" in
  auto)
    case "${TERM_PROGRAM:-}:${TERM:-}" in
      *kitty*|*Kitty*) protocol=kitty ;;
      *iTerm*|*WezTerm*) protocol=iterm2 ;;
      *foot*|*sixel*) protocol=sixel ;;
      *) protocol=halfblocks ;;
    esac
    ;;
  sixel|kitty|iterm2|halfblocks) ;;
  *) fail "unsupported image protocol: $protocol" ;;
esac

# Split arguments into agent commands at `::` without using eval.
agents=()
current=()
for argument in "$@"; do
  if [[ $argument == "::" ]]; then
    (( ${#current[@]} )) || fail "empty agent command before ::"
    agents+=("$(command_string "${current[@]}")")
    current=()
  else
    current+=("$argument")
  fi
done
if (( ${#current[@]} )); then
  agents+=("$(command_string "${current[@]}")")
elif (( $# )) && [[ ${!#} == "::" ]]; then
  fail "empty agent command after ::"
fi

if (( restore )) && [[ -n $session_name ]] && tmux has-session -t "=$session_name" 2>/dev/null; then
  if [[ -n ${TMUX:-} ]]; then
    exec tmux switch-client -t "$session_name"
  elif (( attach )); then
    exec tmux attach-session -t "$session_name"
  else
    printf 'TIDE workspace already exists: %s\n' "$session_name"
    exit 0
  fi
fi

if [[ -n ${TMUX:-} ]]; then
  workspace=${TMUX_PANE:?}
  tmux rename-window -t "$workspace" "$(basename "$project")"
else
  if [[ -z $session_name ]]; then
    safe_name=$(basename "$project" | tr -cs '[:alnum:]_-' '-')
    session_name="tide-${safe_name:-workspace}-$$"
  fi
  tmux has-session -t "=$session_name" 2>/dev/null && fail "tmux session already exists: $session_name"
  workspace=$(tmux new-session -d -s "$session_name" -c "$project" -P -F '#{pane_id}')
  tmux set-option -t "$session_name" @tide_project "$project"
  tmux rename-window -t "$workspace" "$(basename "$project")"
fi

# Mouse selection makes a click focus Explorer, Editor, Agent, or Terminal.
tmux set-option -t "$workspace" mouse on

# Build the configured workspace while retaining the original pane for the editor.
shell_pane=$(tmux split-window -v -l "${shell_size}%" -t "$workspace" -c "$project" -P -F '#{pane_id}')
case "$layout" in
  classic)
    agent_pane=$(tmux split-window -h -l "${agent_size}%" -t "$workspace" -c "$project" -P -F '#{pane_id}')
    ;;
  agents-left)
    agent_pane=$(tmux split-window -h -b -l "${agent_size}%" -t "$workspace" -c "$project" -P -F '#{pane_id}')
    ;;
  agents-bottom)
    agent_pane=$(tmux split-window -v -l "${agent_size}%" -t "$workspace" -c "$project" -P -F '#{pane_id}')
    ;;
esac
# Label panes and expose their roles to TIDE's conditional function-key bindings.
tmux set-option -p -t "$workspace" @tide_role editor
tmux set-option -p -t "$shell_pane" @tide_role terminal
tmux set-option -p -t "$agent_pane" @tide_role agent
primary_agent_pane=$agent_pane
agent_pane_ids=("$agent_pane")

# Keep the project shell idle and ready for input.
tmux select-pane -t "$shell_pane"

if (( ${#agents[@]} )); then
  tmux send-keys -t "$agent_pane" -l "${agents[0]}"
  tmux send-keys -t "$agent_pane" C-m
  for (( index=1; index<${#agents[@]}; index++ )); do
    agent_pane=$(tmux split-window -v -t "$agent_pane" -c "$project" -P -F '#{pane_id}')
    tmux set-option -p -t "$agent_pane" @tide_role agent
    agent_pane_ids+=("$agent_pane")
    tmux send-keys -t "$agent_pane" -l "${agents[index]}"
    tmux send-keys -t "$agent_pane" C-m
  done
fi

agent_panes_csv=$(IFS=,; printf '%s' "${agent_pane_ids[*]}")
tmux set-option -w -t "$workspace" @tide_editor_pane "$workspace"
tmux set-option -w -t "$workspace" @tide_agent_pane "$primary_agent_pane"
tmux set-option -w -t "$workspace" @tide_agent_panes "$agent_panes_csv"
tmux set-option -w -t "$workspace" @tide_terminal_pane "$shell_pane"
tmux set-option -w -t "$workspace" @tide_layout "$layout"
tmux set-option -w -t "$workspace" @tide_shell_size "$shell_size"
tmux set-option -w -t "$workspace" @tide_agent_size "$agent_size"
tmux set-option -w -t "$workspace" @tide_editor_visible 1
tmux set-option -w -t "$workspace" @tide_agent_visible 1
tmux set-option -w -t "$workspace" @tide_terminal_visible 1

# Home-row bindings only act in a TIDE window; elsewhere tmux passes them through.
tmux bind-key -n C-S-a if-shell -F '#{!=:#{@tide_editor_pane},}' \
  'send-keys -t "#{@tide_editor_pane}" C-S-a' 'send-keys C-S-a'
tmux bind-key -n C-S-s if-shell -F '#{!=:#{@tide_editor_pane},}' \
  'run-shell "tide --_toggle-pane editor #{pane_id}"' 'send-keys C-S-s'
tmux bind-key -n C-S-d if-shell -F '#{!=:#{@tide_editor_pane},}' \
  'send-keys -t "#{@tide_editor_pane}" C-S-d' 'send-keys C-S-d'
tmux bind-key -n C-S-f if-shell -F '#{!=:#{@tide_agent_pane},}' \
  'run-shell "tide --_toggle-pane agent #{pane_id}"' 'send-keys C-S-f'
tmux bind-key -n C-S-g if-shell -F '#{!=:#{@tide_terminal_pane},}' \
  'run-shell "tide --_toggle-pane terminal #{pane_id}"' 'send-keys C-S-g'

editor_command=$(command_string env "TIDE_IMAGE_PROTOCOL=$protocol" tide-editor "$project")
# Clear the shell screen before starting the editor so the internal launch command
# does not remain visible above the TUI.
tmux send-keys -t "$workspace" -l "clear; $editor_command"
tmux send-keys -t "$workspace" C-m
tmux select-pane -t "$workspace"

if [[ -n ${TMUX:-} ]]; then
  exit 0
fi
if (( attach )); then
  exec tmux attach-session -t "$session_name"
else
  printf 'Created TIDE workspace: %s\nAttach with: tmux attach -t %q\n' "$session_name" "$session_name"
fi
